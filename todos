#!/usr/bin/env python3
# todos: the launcher. Runs invoke_todos.cli.main from this clone with no install step; a symlink to this
# file from anywhere on PATH works too (realpath). `todos help` lists the verbs; README.md is the reference.
import os
import sys

if sys.version_info < (3, 9):
    sys.exit("todos needs Python 3.9 or later; this is %s" % sys.version.split()[0])
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from invoke_todos.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
